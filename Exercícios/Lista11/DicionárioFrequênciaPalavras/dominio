package Exercícios.Lista11.DicionárioFrequênciaPalavras.dominio;

import java.util.Map;
import java.util.HashMap;
import java.util.Scanner;

public class Dicionario{
    
    public void formatador(String texto){
        
        String[] palavras = texto.toLowerCase().split("\\s+");
        
        Map<String, Integer> cont = new HashMap<>();
        
        for(String palavra : palavras){
            cont.put(palavra, cont.getOrDefault(palavra,0) + 1);
        }
        
        for(Map.Entry<String, Integer> par : cont.entrySet()){
            System.out.println("Palavra: " + par.getKey() + "\t Aparicoes: " + par.getValue() + "\n");
        }
        
    }
}
